# Copy this file to .env and fill in your own values.

PORT=5001
NODE_ENV=development

# MongoDB Atlas connection string (Atlas supports transactions)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/service-provider-app

# Long random strings (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
ACCESS_TOKEN_SECRETE=change-me
REFRESH_TOKEN_SECRETE=change-me-too

# ImageKit (https://imagekit.io -> Developer options)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your-id>

# Optional. The app works without Redis (no caching).
REDIS_URL=redis://127.0.0.1:6379
# Optional: prefix for cache keys when several apps share one Redis
CACHE_PREFIX=ustaad:

# Frontend URL(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173

# Used by `npm run seed` to create the first admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
